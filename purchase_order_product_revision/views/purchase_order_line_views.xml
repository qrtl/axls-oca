<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Purchase Order Form View Inheritance -->
    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.product.revision</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree//field[@name='product_id']"
                position="attributes"
            >
                <attribute name="context">{'product_id': product_id}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree//field[@name='product_id']"
                position="after"
            >
                <field
                    name="product_revision_id"
                    optional="show"
                    context="{'product_id': product_id}"
                />
                <field name="product_revision_number" optional="show" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id']"
                position="attributes"
            >
                <attribute name="context">{'product_id': product_id}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id']"
                position="after"
            >
                <field
                    name="product_revision_id"
                    context="{'product_id': product_id}"
                />
                <field name="product_revision_number" />
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Line Tree View Inheritance -->
    <record id="purchase_order_line_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inherit.product.revision</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="context">{'product_id': product_id}</attribute>
            </field>
            <field name="product_id" position="after">
                <field
                    name="product_revision_id"
                    optional="show"
                    context="{'product_id': product_id}"
                />
                <field name="product_revision_number" optional="show" />
            </field>
        </field>
    </record>

    <!-- Purchase Order Line Form View Inheritance -->
    <record id="purchase_order_line_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.form.inherit.product.revision</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2" />
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="context">{'product_id': product_id}</attribute>
            </field>
            <field name="product_id" position="after">
                <field
                    name="product_revision_id"
                    context="{'product_id': product_id}"
                />
                <field name="product_revision_number" />
            </field>
        </field>
    </record>

    <!-- Purchase Order Line Search View Inheritance -->
    <record id="purchase_order_line_search_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.search.inherit.product.revision</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_search" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="product_revision_id" />
                <field name="product_revision_number" />
            </field>
            <filter name="groupby_product" position="after">
                <filter
                    name="groupby_revision"
                    string="Product Revision"
                    context="{'group_by': 'product_revision_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
