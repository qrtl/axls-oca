<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_unbuild_form_view_inherit_location" model="ir.ui.view">
        <field name="name">mrp.unbuild.form.inherit.location</field>
        <field name="model">mrp.unbuild</field>
        <field name="inherit_id" ref="mrp.mrp_unbuild_form_view" />
        <field name="arch" type="xml">
            <field name="location_id" position="before">
                <field name="location_id_domain" invisible="1" />
            </field>
            <field name="location_id" position="attributes">
                <attribute
                    name="domain"
                >location_id_domain and [('id', 'in', location_id_domain)] or [('usage', '=', 'internal'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]</attribute>
            </field>
        </field>
    </record>
</odoo>
