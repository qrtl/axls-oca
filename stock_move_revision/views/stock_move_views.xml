<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Stock Move Form View Inheritance -->
    <record id="view_stock_move_form_inherit" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.product.revision</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="product_revision_id" />
                <field name="product_revision_number" />
            </field>
        </field>
    </record>

    <!-- Stock Move Tree View Inheritance -->
    <record id="view_stock_move_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.tree.inherit.product.revision</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="product_revision_id" optional="show" />
                <field name="product_revision_number" optional="show" />
            </field>
        </field>
    </record>

    <!-- Stock Move Search View Inheritance -->
    <record id="view_stock_move_search_inherit" model="ir.ui.view">
        <field name="name">stock.move.search.inherit.product.revision</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="product_revision_id" />
                <field name="product_revision_number" />
            </field>
            <filter name="by_product" position="after">
                <filter
                    string="Product Revision"
                    name="groupby_revision"
                    domain="[]"
                    context="{'group_by': 'product_revision_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
