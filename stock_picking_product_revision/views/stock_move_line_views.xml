<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Stock Picking Form View Inheritance -->
    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.product.revision</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_ids_without_package']/tree/field[@name='product_id']"
                position="after"
            >
                <field name="product_revision_id" optional="show" />
                <field name="product_revision_number" optional="show" />
            </xpath>
        </field>
    </record>

    <!-- Stock Move Line Tree View Inheritance -->
    <record id="view_stock_move_line_tree_inherit" model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.product.revision</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="product_revision_id" optional="show" />
                <field name="product_revision_number" optional="show" />
            </field>
        </field>
    </record>
</odoo>
