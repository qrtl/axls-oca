<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Assign Revision Wizard Form View -->
    <record id="view_assign_revision_wizard_form" model="ir.ui.view">
        <field name="name">assign.revision.wizard.form</field>
        <field name="model">assign.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Revision">
                <sheet>
                    <group>
                        <field name="lot_id" invisible="1" />
                        <field name="product_id" />
                        <field name="revision_id" options="{'no_create': True}" />
                        <field name="revision_number" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_assign_revision"
                        string="Assign"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Assign Revision Wizard Action -->
    <record id="action_assign_revision_wizard" model="ir.actions.act_window">
        <field name="name">Assign Revision</field>
        <field name="res_model">assign.revision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
